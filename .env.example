# 根据分析前选择的 LLM，在本地 .env 或系统环境变量中配置相应 Key。
# .env 已被 .gitignore 排除，请勿提交真实密钥。

# DeepSeek（可选）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ChatGPT / OpenAI（可选）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# GitHub Copilot（通过 GitHub Models，需具有 Models 访问权限的 GitHub Token；可替代为 GITHUB_TOKEN）
COPILOT_API_KEY=github_pat_xxxxxxxxxxxxxxxx
COPILOT_BASE_URL=https://models.github.ai/inference
COPILOT_MODEL=openai/gpt-4.1